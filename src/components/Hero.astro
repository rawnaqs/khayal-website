<script is:inline>
  (function() {
    var tilt = document.querySelector('.hero-video-tilt');
    var video = document.querySelector('.hero-video');

    if (tilt && video) {
      tilt.addEventListener('mousemove', function(e) {
        var rect = tilt.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var centerX = rect.width / 2;
        var centerY = rect.height / 2;
        var rotateX = (y - centerY) / centerY * -4;
        var rotateY = (x - centerX) / centerX * 4;
        video.style.transform = 'rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg)';
      });

      tilt.addEventListener('mouseleave', function() {
        video.style.transform = 'rotateX(0) rotateY(0)';
      });
    }

    var cmds = {
      curl: 'curl -fsSL https://raw.githubusercontent.com/rawnaqs/khayal/main/install.sh | sh',
      brew: 'brew install rawnaqs/tap/khayal',
      docker: 'docker run -v ~/Documents/brain:/vault -v ~/.config/khayal:/root/.config/khayal -p 1133:1133 ghcr.io/rawnaqs/khayal'
    };
    var tabs = document.querySelectorAll('.install-tab');
    var code = document.getElementById('install-code');
    var icon = document.getElementById('copy-icon');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');
        code.textContent = cmds[tab.getAttribute('data-tab')];
        icon.classList.remove('copied');
      });
    });

    window.copyInstall = function() {
      navigator.clipboard.writeText(code.textContent).then(function() {
        icon.classList.add('copied');
        setTimeout(function() { icon.classList.remove('copied'); }, 1500);
      });
    };
  })();
</script>

